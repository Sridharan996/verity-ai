# ==============================================================================
# VERITY AI — Frontend Environment Variables Template (Vite / Vercel)
# ==============================================================================
# In local development:
# Leave VITE_API_BASE_URL blank so requests default to /api and are proxied
# to http://127.0.0.1:8000 by the local Vite development server.
#
# In production (Vercel):
# Set this to your deployed FastAPI backend URL (e.g. Render / Railway).
# Do NOT include a trailing slash.
# Example:
# VITE_API_BASE_URL=https://verity-backend.onrender.com
# ==============================================================================

VITE_API_BASE_URL=


# ==============================================================================
# VERITY AI — Backend Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# Never commit actual credentials or production secrets to version control.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
PROJECT_NAME="VERITY AI Platform Backend"
API_PREFIX=/api

# ==============================================================================
# MongoDB Connection Configuration
# ==============================================================================
# Option 1: Local MongoDB Community Service (Default)
MONGODB_URL=mongodb://127.0.0.1:27017

# Option 2: MongoDB Atlas Cloud Cluster Connection (Takes precedence if set)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://verity_admin:YOUR_PASSWORD_HERE@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
DATABASE_NAME=verity_ai

# Connection and Socket Timeout in milliseconds
MONGODB_TIMEOUT_MS=2000

# ==============================================================================
# File Storage Configuration
# ==============================================================================
# Relative paths are resolved against the backend root directory.
UPLOAD_DIR=uploads

# Maximum allowed file size in bytes (10 MB = 10 * 1024 * 1024 = 10485760 bytes)
MAX_FILE_SIZE_BYTES=10485760

# ==============================================================================
# CORS Allowed Origins
# ==============================================================================
# Comma-separated list of allowed frontend origins, or * for permissive testing.
# In production, replace with your actual Vercel frontend domain:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-project.vercel.app
